{
  "name": "baseline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "types": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "display": "node scripts/check-display.mjs",
    "scaffold": "node scripts/scaffold.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply baseline --local",
    "db:migrate:remote": "wrangler d1 migrations apply baseline --remote",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "gate": "pnpm gate:fast && pnpm build && pnpm smoke",
    "gate:fast": "pnpm types && pnpm lint && pnpm boundaries && pnpm display && pnpm test",
    "rename": "node scripts/rename.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "lefthook": "2.2.2",
    "shadcn": "4.23.0",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "wrangler": "^4.158.0"
  }
}
