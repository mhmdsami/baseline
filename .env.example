# Copy to .dev.vars for local development. Never commit real values.

# Public origin, used for auth callbacks and absolute URLs.
SITE_URL=http://localhost:3000

# better-auth secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google OAuth client. Authorised redirect URI:
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Set to "noindex" to opt out of crawling; unset means crawlable.
# Read at build time, so a change needs a rebuild.
NEXT_PUBLIC_ROBOTS=
